{
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "bloommatrix.in"
        }
      ],
      "destination": "https://www.bloommatrix.in/:path*",
      "statusCode": 301
    },
    {
      "source": "/aira",
      "destination": "/anril",
      "permanent": true
    },
    {
      "source": "/aira/:path*",
      "destination": "/anril/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/anril",
      "destination": "https://anrilai.vercel.app/anril"
    },
    {
      "source": "/anril/:path*",
      "destination": "https://anrilai.vercel.app/anril/:path*"
    }
  ]
}
